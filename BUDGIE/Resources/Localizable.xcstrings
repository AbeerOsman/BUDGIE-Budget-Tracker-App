    "Privacy Policy" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سياسة الخصوصية"
          }
        }
      }
    },
    "privacy.changes" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد نحدّث سياسة الخصوصية من وقت لآخر لتعكس التحسينات أو المتطلبات القانونية أو تحديثات الميزات. يُعد الاستمرار في استخدام التطبيق بعد التحديثات قبولاً للسياسة المعدّلة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We may update this Privacy Policy from time to time to reflect improvements, legal requirements, or feature updates. Continued use of the application after updates constitutes acceptance of the revised policy."
          }
        }
      }
    },
    "privacy.contact" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كانت لديك أسئلة حول سياسة الخصوصية أو كيفية تعامل BUDGIE مع البيانات أو أي استفسار آخر، يُرجى ترك تعليق عبر قسم مراجعات App Store."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have any questions regarding this Privacy Policy, how BUDGIE handles data, or any other inquiries, please leave a comment through the App Store Reviews section."
          }
        }
      }
    },
    "privacy.no_selling" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يقوم BUDGIE بـ:\n\n• بيع بيانات المستخدم\n• مشاركة المعلومات المالية مع أطراف ثالثة\n• استخدام بيانات المعاملات للإعلانات\n• استخدام البيانات الشخصية لتحليلات خارج وظائف التطبيق الأساسية\n• تخزين السجلات المالية على خوادم خارجية للشركة\n\nتُستخدم البيانات التي يعالجها التطبيق حصرياً لتوفير ميزات الميزانية وتتبّع المصروفات والتنظيم المالي داخل التطبيق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BUDGIE does not:\n\n• Sell user data\n• Share financial information with third parties\n• Use transaction data for advertising\n• Use personal data for analytics beyond core app functionality\n• Store user financial records on external company servers\n\nThe data processed by the app is used exclusively to provide budgeting, expense tracking, and financial organization features within the application."
          }
        }
      }
    },
    "privacy.overview" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BUDGIE تطبيق شخصي لتتبّع الميزانية والمصروفات يساعد المستخدمين على مراقبة أنشطتهم المالية وتنظيمها. لتوفير بعض الميزات، قد يستخدم التطبيق أتمتة اختصارات Apple للتعرّف على إشعارات رسائل البنك المتعلقة بالمعاملات والمصروفات ومعالجتها.\n\nهدفنا حصرياً مساعدة المستخدمين على تتبّع إنفاقهم ونشاطهم المالي بطريقة بسيطة وآمنة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BUDGIE is a personal budgeting and expense tracking application designed to help users monitor and organize their financial activities. To provide certain features, the app may use Apple Shortcuts automation to identify and process banking SMS notifications related to transactions and expenses.\n\nOur goal is strictly to help users track their spending and financial activity in a simple and secure way."
          }
        }
      }
    },
    "privacy.responsibility" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بتمكين تكامل اختصارات Apple واستخدام ميزات BUDGIE، يقر المستخدمون ويوافقون على أن:\n\n• يضبطون أتمتة الاختصار ويصرّحون بها طوعاً\n• يفهمون كيف تصل اختصارات Apple إلى إشعارات الرسائل على أجهزتهم\n• يتحملون مسؤولية مراجعة أذونات الجهاز وإعدادات الاختصار\n\nيعمل BUDGIE فقط ضمن الأذونات التي يمنحها المستخدم صراحةً وإطار نظام Apple."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By enabling Apple Shortcuts integrations and using BUDGIE features, users acknowledge and accept that:\n\n• They voluntarily configure and authorize the Shortcut automation\n• They understand how Apple Shortcuts accesses SMS notifications on their device\n• They are responsible for reviewing and managing their device permissions and Shortcut settings\n\nBUDGIE operates only within the permissions explicitly granted by the user and Apple’s system framework."
          }
        }
      }
    },
    "privacy.security" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نعطي أولوية لخصوصية المستخدم ونعتمد على نظام Apple الآمن وتقنيات التخزين المحلي على الجهاز لحماية المعلومات.\n\nمع اتخاذنا تدابير معقولة لدعم التعامل الآمن بالبيانات، يتحمل المستخدمون مسؤولية أمان أجهزتهم وحسابات Apple وبيانات الدخول."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We prioritize user privacy and rely on Apple’s secure ecosystem and local device storage technologies to help protect user information.\n\nWhile we take reasonable measures to support secure data handling, users are responsible for maintaining the security of their own devices, Apple accounts, and access credentials."
          }
        }
      }
    },
    "privacy.shortcuts" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم BUDGIE اختصارات Apple فقط كأداة أتمتة يفعّلها المستخدم للوصول إلى إشعارات رسائل البنك على جهازه ومعالجتها.\n\nيستخرج التطبيق فقط معلومات محدودة متعلقة بالمعاملات اللازمة لتتبّع المصروفات، بما في ذلك:\n\n• اسم التاجر\n• مبلغ المعاملة\n• تاريخ ووقت المعاملة\n• تفاصيل أساسية ذات صلة بالميزانية\n\nلا يصل BUDGIE إلى محتوى رسائل غير ذي صلة أو محادثات شخصية أو كلمات مرور أو رموز تحقق أو اتصالات حساسة، ولا يجمعها أو يراقبها أو يخزّنها.\n\nلا يحاول التطبيق الوصول غير المصرّح به إلى بيانات المستخدم أو أنظمة البنوك أو معلومات خاصة بخلاف تفاصيل المعاملات التي تُعالج عمداً عبر أتمتة الاختصار التي يضبطها المستخدم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BUDGIE uses Apple Shortcuts solely as a user-enabled automation tool to access and process banking SMS notifications on the user’s device.\n\nThe application only extracts limited transaction-related information necessary for expense tracking, including:\n\n• Merchant name\n• Transaction amount\n• Transaction date and time\n• Basic transaction details relevant to budgeting\n\nBUDGIE does not access, collect, monitor, or store unrelated SMS content, personal conversations, passwords, authentication codes, or sensitive personal communications.\n\nThe app does not attempt to gain unauthorized access to user data, banking systems, or private information beyond the transaction details intentionally processed through the user’s configured Shortcut automation."
          }
        }
      }
    },
    "privacy.storage" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزَّن جميع بيانات المعاملات التي يعالجها BUDGIE محلياً على جهاز المستخدم باستخدام تقنيات Apple مثل SwiftData.\n\nإذا كان مزامنة iCloud مفعّلة، تتم المزامنة بأمان عبر Apple CloudKit وترتبط فقط بحساب iCloud الشخصي للمستخدم.\n\nلا يملك مطوّرو BUDGIE وصولاً إلى:\n\n• رسائل البنك\n• سجل المعاملات\n• السجلات المالية\n• محتوى الرسائل الشخصية\n• بيانات iCloud\n• قواعد بيانات المستخدم\n\nلا نحتفظ بخوادم خارجية تحتوي على معلومات مالية للمستخدم.\n\nيبقى المستخدمون المالكين الوحيدين والمسيطرين على بياناتهم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All transaction data processed by BUDGIE is stored locally on the user’s device using Apple technologies such as SwiftData.\n\nIf iCloud synchronization is enabled, synchronization occurs securely through Apple CloudKit and is associated only with the user’s personal Apple iCloud account.\n\nBUDGIE developers do not have access to:\n\n• User banking messages\n• Transaction history\n• Financial records\n• Personal SMS content\n• iCloud data\n• User databases\n\nWe do not maintain external servers containing user financial information.\n\nUsers remain the sole owners and controllers of their data."
          }
        }
      }
    },
